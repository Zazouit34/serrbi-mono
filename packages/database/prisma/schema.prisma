generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  emailVerified     DateTime?
  password          String?
  role              Role               @default(USER)
  name              String
  phone             String?
  image             String?
  resumeUrl         String?
  // Dense embedding vector for the latest uploaded resume / cv
  resumeEmbedding   Float[]            @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  customer          Customer?
  favorites         Favorite[]
  moderatedJobs     Job[]              @relation("JobModerator")
  jobs              Job[]
  moderationActions ModerationAction[]
  notifications     Notification[]
  payments          Payment[]
  proposals         Proposal[]
  moderatedServices Service[]          @relation("ServiceModerator")
  services          Service[]
  subscription      Subscription?
  moderatedTasks    Task[]             @relation("TaskModerator")
  tasks             Task[]
  autoApplyEnabled     Boolean       @default(false)
  autoApplyCategory    JobCategory?  // single category
  autoApplyKeywords    String[]      // user-selected tags
  autoApplyRoles       String[]      @default([]) // user-selected roles per category
  aiChatUsages         AiChatUsage[]
 


  @@index([email])
  @@index([role])
  @@index([name])
  @@index([phone])
  @@index([image])
  @@index([emailVerified])
  @@index([createdAt])
  @@index([updatedAt])
}

model AiChatUsage {
  id         String   @id @default(uuid())
  userId     String
  dayBucket  DateTime
  requests   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayBucket])
  @@index([userId])
  @@index([dayBucket])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String
  expires DateTime

  @@unique([email, token])
}

model Job {
  id                  String              @id @default(uuid())
  userId              String
  title               String
  companyName         String?
  companyImage        String?
  description         String
  wage                Int?
  countryIso2         String?
  stateAbbreviation   String?
  city                String?
  category            JobCategory
  locationRequirement LocationRequirement
  experienceLevel     ExperienceLevel
  status              JobListingStatus    @default(pending)
  type                JobListingType
  applicationEmail    String
  applicationUrl      String?
  postedAt            DateTime?
  rejectionReason     String?
  moderatedAt         DateTime?
  moderatedBy         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tags                String[]            @default([])  //skill tags
  // Dense embedding vector for semantic search (DashScope text-embedding-v4)
  embedding           Float[]             @default([])
  // Pgvector column for efficient similarity search (1024 dims, see migration)
  embeddingVector     Unsupported("vector")? @map("embedding_vector")
  favorites           Favorite?
  moderator           User?               @relation("JobModerator", fields: [moderatedBy], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  application         JobApplication[]
  ModerationAction    ModerationAction[]

  @@index([locationRequirement])
  @@index([category])
  @@index([experienceLevel])
  @@index([type])
  @@index([status])
  @@index([title])
  @@index([companyName])
  @@index([city])
  @@index([countryIso2])
  @@index([createdAt])
  @@index([moderatedAt])
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  jobTitle  String
  name      String
  email     String
  cv        Boolean  @default(false)
  source    String   @default("manual")
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model Service {
  id                String             @id @default(uuid())
  userId            String
  displayName       String?
  displayImage      String?
  images            String
  title             String
  description       String
  price             Int
  // Dense embedding vector for semantic search
  embedding         Float[]            @default([])
  city              String?
  stateAbbreviation String?
  address           String?
  latitude          Float?
  longitude         Float?
  phoneNumber       String?
  email             String?
  website           String?
  openingHours      String?
  averageRating     Float?             
  numberOfReviews   Int                @default(0)
  // Pgvector column for efficient similarity search (1024 dims, see migration)
  embeddingVector   Unsupported("vector")? @map("embedding_vector")
  status            ServiceStatus      @default(pending)
  rejectionReason   String?
  moderatedAt       DateTime?
  moderatedBy       String?
  createdAt         DateTime           @default(now())
  serviceCategory   ServiceCategory
  type              String?
  favorites         Favorite?
  ModerationAction  ModerationAction[]
  moderator         User?              @relation("ServiceModerator", fields: [moderatedBy], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  bookings          ServiceBooking[]

  @@index([userId])
  @@index([serviceCategory])
  @@index([city])
  @@index([stateAbbreviation])
  @@index([status])
  @@index([createdAt])
  @@index([moderatedAt])
}

model ServiceBooking {
  id            String            @id @default(uuid())
  serviceId     String
  serviceTitle  String
  name          String
  email         String
  phone         String
  message       String?
  preferredDate String?
  preferredTime String?
  status        ReservationStatus @default(Pending)
  createdAt     DateTime          @default(now())
  service       Service           @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([status])
}

model Task {
  id                String             @id @default(uuid())
  userId            String
  title             String?
  description       String
  category          TaskCategory
  status            TaskStatus         @default(Pending)
  phoneNumber       String?
  email             String?
  budget            Int?
  // budgetType removed
  city              String?
  stateAbbreviation String?
  address           String?
  latitude          Float?
  longitude         Float?
  images            String
  displayName       String?
  displayImage      String?
  deadline          DateTime?
  bgStyle           String?
  rejectionReason   String?
  moderatedAt       DateTime?
  moderatedBy       String?
  createdAt         DateTime           @default(now())
  favorites         Favorite?
  ModerationAction  ModerationAction[]
  proposals         Proposal[]
  moderator         User?              @relation("TaskModerator", fields: [moderatedBy], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([city])
  @@index([stateAbbreviation])
  @@index([address])
  @@index([budget])
  @@index([createdAt])
  @@index([moderatedAt])
}

model Proposal {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  amount    Int
  message   String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  jobId     String?  @unique
  serviceId String?  @unique
  taskId    String?  @unique
  createdAt DateTime @default(now())
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([serviceId])
  @@index([taskId])
}

model ModerationAction {
  id        String   @id @default(uuid())
  adminId   String
  itemType  String
  itemId    String
  action    String
  reason    String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])
  Job       Job      @relation(fields: [itemId], references: [id], map: "ModerationAction_jobId_fkey")
  Service   Service  @relation(fields: [itemId], references: [id], map: "ModerationAction_serviceId_fkey")
  Task      Task     @relation(fields: [itemId], references: [id], map: "ModerationAction_taskId_fkey")

  @@index([adminId])
  @@index([itemType])
  @@index([itemId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  itemType  String?
  itemId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
}

model SubscriptionPlanConfig {
  id                 String           @id @default(uuid())
  name               SubscriptionPlan @unique
  displayName        String
  description        String?
  price              Int
  currency           String           @default("USD")
  interval           String
  maxJobListings     Int?
  maxServiceListings Int?
  maxTaskListings    Int?
  featuredListings   Boolean          @default(false)
  prioritySupport    Boolean          @default(false)
  analyticsAccess    Boolean          @default(false)
  // New application-based fields
  monthlyApplyLimit      Int?
  autoApplyMonthlyLimit  Int?
  jobBoardAccess         Boolean          @default(true)
  smartMatchAccess       Boolean          @default(false)
  resumeAtsScoreAccess   Boolean          @default(true)
  autoApplyAccess        Boolean          @default(false)
  paddlePriceId      String?
  paddleProductId    String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  subscriptions      Subscription[]

  @@index([name])
  @@index([isActive])
}

model Subscription {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  planId               String
  paddleSubscriptionId String?                @unique
  paddleCustomerId     String?
  status               SubscriptionStatus     @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  canceledAt           DateTime?
  pausedAt             DateTime?
  jobListingsUsed      Int                    @default(0)
  serviceListingsUsed  Int                    @default(0)
  taskListingsUsed     Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  payments             Payment[]
  plan                 SubscriptionPlanConfig @relation(fields: [planId], references: [id])
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paddleSubscriptionId])
  @@index([currentPeriodEnd])
  @@index([createdAt])
}

model Customer {
  id               String   @id @default(uuid())
  userId           String   @unique
  paddleCustomerId String   @unique
  email            String?
  name             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paddleCustomerId])
  @@index([userId])
}

model Payment {
  id                  String        @id @default(uuid())
  subscriptionId      String?
  userId              String
  paddlePaymentId     String?       @unique
  paddleTransactionId String?       @unique
  amount              Int
  currency            String      
  status              PaymentStatus @default(PENDING)
  description         String?
  paymentMethod       String?
  failureReason       String?
  paidAt              DateTime?
  refundedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  user                User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paddlePaymentId])
  @@index([createdAt])
}

model WebhookEvent {
  id          String           @id @default(uuid())
  eventType   WebhookEventType
  eventId     String           @unique
  data        Json
  processed   Boolean          @default(false)
  processedAt DateTime?
  attempts    Int              @default(0)
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
  @@index([attempts])
}

enum Role {
  USER
  ADMIN
  COMPANY
}

enum JobCategory {
  Tech
  Finance
  Hospitality
  Health
  Legal
  Construction
  Education
  CallCenter
  Auto
  Cleaning
  Other
}

enum LocationRequirement {
  in_office
  hybrid
  remote
}

enum ExperienceLevel {
  junior
  mid_level
  senior
}

enum JobListingType {
  internship
  part_time
  full_time
}

enum JobListingStatus {
  draft
  pending
  published
  rejected
  delisted
  expired
}

enum ServiceStatus {
  draft
  pending
  published
  rejected
  delisted
}

enum ServiceCategory {
  Lawyer
  Doctor
  Education
  Architect
  Plumber
  Electrician
  Mason
  Mechanic
  Accountant
  Esthetician
  Cleaning
}


enum ReservationStatus {
  Pending
  Denied
  Approved
}

enum TaskCategory {
  MultiSector
  Health
  Cleaning
  Construction
  Auto
  Tech
  Finance
  Hospitality
  Legal
  Education
}


enum TaskStatus {
  Active
  Pending
  Published
  Rejected
  Done
  Cancelled
}

// Subscription System Models
enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELED
  TRIALING
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum WebhookEventType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  INVOICE_PAYMENT_SUCCEEDED
  INVOICE_PAYMENT_FAILED
}
