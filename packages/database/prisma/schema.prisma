// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//users roles
enum Role {
  USER
  ADMIN
  COMPANY
}

//Job Listing Enums
enum JobCategory {
  Tech
  Finance
  Hospitality
  Health
  Legal
  Construction
  Education
  CallCenter
  Auto
  Cleaning
  Other
}

enum LocationRequirement {
  in_office
  hybrid
  remote
}

enum ExperienceLevel {
  junior
  mid_level
  senior
}

enum JobListingType {
  internship
  part_time
  full_time
}

enum JobListingStatus {
  draft
  published
  delisted
  expired
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  password      String? // Optional for OAuth users
  role          Role      @default(USER)
  name          String
  phone         String? // Optional for OAuth users
  image         String? // Profile image from OAuth or uploaded later

  accounts  Account[]
  jobs      Job[]
  services  Service[]
  tasks     Task[]
  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String
  expires DateTime

  @@unique([email, token])
}

model Job {
  id                  String              @id @default(uuid())
  userId              String
  title               String
  companyName         String?
  companyImage        String?
  description         String
  wage                Int?
  stateAbbreviation   String?
  city                String?
  category            JobCategory
  locationRequirement LocationRequirement
  experienceLevel     ExperienceLevel
  status              JobListingStatus    @default(draft)
  type                JobListingType
  applicationEmail    String
  applicationUrl      String?
  postedAt            DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  user        User             @relation(fields: [userId], references: [id])
  application JobApplication[]

  @@index([locationRequirement])
  @@index([category])
  @@index([experienceLevel])
  @@index([type])
  @@index([status])
  @@index([title])
  @@index([companyName])
  @@index([city])
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  jobTitle  String
  name      String
  email     String
  cv        Boolean  @default(false)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

//Services
enum ServiceCategory {
  Lawyer
  Doctor
  Education
  Architect
  Plumber
  Electrician
  Mason
  Mechanic
  Accountant
  Esthetician
  Cleaning
}

enum PriceType {
  fixed
  hourly
  starting_from
}

enum ReservationStatus {
  Pending
  Denied
  Approved
}

model Service {
  id     String @id @default(uuid())
  userId String

  displayName  String?
  displayImage String?
  images       String[]

  title       String
  description String

  price     Int
  priceType PriceType?

  city              String?
  stateAbbreviation String?
  address           String?
  latitude          Float?
  longitude         Float?

  phoneNumber String?
  email       String?
  website     String?

  // Opening hours like YellowPages (Mon 09:00-19:00, etc.)
  openingHours String?

  averageRating   Float? @default(0)
  numberOfReviews Int    @default(0)

  createdAt DateTime @default(now())

  // Relations
  serviceCategory ServiceCategory
  type            String? // subtype, e.g. "Dentist", "Plumber"
  user            User             @relation(fields: [userId], references: [id])
  bookings        ServiceBooking[]

  @@index([userId])
  @@index([serviceCategory])
  @@index([city])
  @@index([stateAbbreviation])
}

model ServiceBooking {
  id            String            @id @default(uuid())
  serviceId     String
  serviceTitle  String
  name          String
  email         String
  phone         String
  message       String?
  preferredDate String? // ISO date string
  preferredTime String? // Time string
  status        ReservationStatus @default(Pending)
  createdAt     DateTime          @default(now())

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([status])
}

enum TaskCategory {
  MultiSector
  Health
  Cleaning
  Construction
  Auto
  Tech
  Finance
  Hospitality
  Legal
  Education
}

enum BudgetType {
  Fixed
  Negotiable
}

enum TaskStatus {
  Active
  Done
  Cancelled
}

model Task {
  id                String       @id @default(uuid())
  userId            String
  title             String
  description       String
  category          TaskCategory
  status            TaskStatus   @default(Active)
  phoneNumber       String?
  email             String?
  budget            Int?
  budgetType        BudgetType?
  city              String?
  stateAbbreviation String?
  address           String?
  latitude          Float?
  longitude         Float?
  images            String[]

  displayName  String?
  displayImage String?
  deadline     DateTime?

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  proposals Proposal[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([city])
  @@index([stateAbbreviation])
  @@index([address])
  @@index([budget])
}

model Proposal {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  amount    Int
  message   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}
