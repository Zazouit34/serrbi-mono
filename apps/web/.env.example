# Copy to .env.local and fill in your values

# Database (pooled for runtime)
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Auth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI — Claude (required for chat + resume analyzer)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Admin integration (optional)
ADMIN_API_TOKEN=""

# AWS S3 (optional — file uploads)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# Supabase (optional — resume PDF storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE=""

# Paddle (optional — subscriptions)
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT="sandbox"
PADDLE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Email (optional)
RESEND_API_KEY=""

# Domain
NEXT_PUBLIC_PRIMARY_DOMAIN="serrbi.ma"
NEXT_PUBLIC_SITE_URL="https://serrbi.ma"
