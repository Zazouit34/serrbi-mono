{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AUTH_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "DATABASE_URL",
    "RESEND_API_KEY",
    "AUTH_TRUST_HOST",
    "ADMIN_API_TOKEN",
    "ADMIN_ORIGIN",
    "SUPABASE_SERVICE_ROLE",
    "PADDLE_API_KEY",
    "PADDLE_ENVIRONMENT",
    "PADDLE_WEBHOOK_SECRET",
    "PADDLE_PRICE_ID_BASIC",
    "PADDLE_PRICE_ID_PREMIUM",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_S3_BUCKET_NAME",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PRIMARY_DOMAIN"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    
    
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
