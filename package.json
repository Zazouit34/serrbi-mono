{
  "name": "serrbi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:web": "cd apps/web && npm run build",
    "clean": "rm -rf node_modules apps/*/.next apps/*/.turbo .turbo",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/database && npx prisma generate",
    "postinstall": "pnpm db:generate",
    "db:push": "cd packages/database && npx prisma db push",
    "db:migrate": "cd packages/database && npx prisma migrate deploy",
    "seed": "node seed-database.js",
    "seed:force": "node seed-database.js --force",
    "clear-seed": "node clear-seed-data.js"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.5.1",
    "prisma": "6.15.0",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "engines": {
    "node": ">=20"
  }
}
